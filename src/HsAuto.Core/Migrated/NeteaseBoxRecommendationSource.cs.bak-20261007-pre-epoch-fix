    private static ProcessIntegrityInfo ReadProcessIntegrity(int processId)
    {
        nint num = OpenProcess(4096u, inheritHandle: false, processId);
        if (num == IntPtr.Zero)
        {
            return ProcessIntegrityInfo.Unknown(Marshal.GetLastWin32Error());
        }

        try
        {
            if (!OpenProcessToken(num, 8u, out var tokenHandle))
            {
                return ProcessIntegrityInfo.Unknown(Marshal.GetLastWin32Error());
            }

            try
            {
                GetTokenInformation(tokenHandle, 25, IntPtr.Zero, 0, out var returnLength);
                if (returnLength <= 0)
                {
                    return ProcessIntegrityInfo.Unknown(Marshal.GetLastWin32Error());
                }

                nint num2 = Marshal.AllocHGlobal(returnLength);
                try
                {
                    if (!GetTokenInformation(tokenHandle, 25, num2, returnLength, out var _))
                    {
                        return ProcessIntegrityInfo.Unknown(Marshal.GetLastWin32Error());
                    }

                    TokenMandatoryLabel tokenMandatoryLabel = Marshal.PtrToStructure<TokenMandatoryLabel>(num2);
                    if (tokenMandatoryLabel.Label.Sid == IntPtr.Zero)
                    {
                        return ProcessIntegrityInfo.Unknown(0);
                    }

                    nint sidSubAuthorityCount = GetSidSubAuthorityCount(tokenMandatoryLabel.Label.Sid);
                    if (sidSubAuthorityCount == IntPtr.Zero)
                    {
                        return ProcessIntegrityInfo.Unknown(Marshal.GetLastWin32Error());
                    }

                    byte b = Marshal.ReadByte(sidSubAuthorityCount);
                    if (b == 0)
                    {
                        return ProcessIntegrityInfo.Unknown(0);
                    }

                    nint sidSubAuthority = GetSidSubAuthority(tokenMandatoryLabel.Label.Sid, (uint)(b - 1));
                    if (sidSubAuthority == IntPtr.Zero)
                    {
                        return ProcessIntegrityInfo.Unknown(Marshal.GetLastWin32Error());
                    }

                    return ProcessIntegrityInfo.FromRid((uint)Marshal.ReadInt32(sidSubAuthority));
                }
                finally
                {
                    Marshal.FreeHGlobal(num2);
                }
            }
            finally
            {
                CloseHandle(tokenHandle);
            }
        }
        finally
        {
            CloseHandle(num);
        }
    }

