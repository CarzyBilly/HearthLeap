    private static bool TryReadRegion(nint processHandle, ulong requestedAddress, out ulong actualBaseAddress, out byte[] bytes, out int win32Error)
    {
        actualBaseAddress = 0uL;
        bytes = Array.Empty<byte>();
        win32Error = 0;
        if (VirtualQueryEx(processHandle, new IntPtr((long)requestedAddress), out var buffer, (nuint)Marshal.SizeOf<MemoryBasicInformation>()) == 0)
        {
            win32Error = Marshal.GetLastWin32Error();
            return false;
        }

        actualBaseAddress = (ulong)((IntPtr)buffer.BaseAddress).ToInt64();
        ulong num = ((UIntPtr)buffer.RegionSize).ToUInt64();
        if (!IsReadablePrivateRegion(buffer, num))
        {
            return false;
        }

        bytes = new byte[(uint)num];
        if (!ReadProcessMemory(processHandle, buffer.BaseAddress, bytes, (nuint)bytes.Length, out var bytesRead) || bytesRead == 0)
        {
            win32Error = Marshal.GetLastWin32Error();
            bytes = Array.Empty<byte>();
            return false;
        }

        if (bytesRead < (nuint)bytes.Length)
        {
            Array.Resize(ref bytes, checked((int)bytesRead));
        }

        return true;
    }

    private static bool IsReadablePrivateRegion(MemoryBasicInformation memory, ulong regionSize)
    {
        if (memory.State != 4096 || memory.Type != 131072 || regionSize == 0L || regionSize > 67108864 || (memory.Protect & 0x100) != 0)
        {
            return false;
        }

        switch (memory.Protect & 0xFF)
        {
            case 2u:
            case 4u:
            case 8u:
            case 32u:
            case 64u:
            case 128u:
                return true;
            default:
                return false;
        }
    }

    private static bool ContainsRecommendationCallback(byte[] bytes)
    {
        if (bytes.AsSpan().IndexOf(CallbackMarker) < 0)
        {
            return bytes.AsSpan().IndexOf(CallbackMarkerUtf16) >= 0;
        }

        return true;
    }

    private static bool ContainsWinRateCallback(byte[] bytes)
    {
        if (bytes.AsSpan().IndexOf(WinRateCallbackMarker) < 0)
        {
            return bytes.AsSpan().IndexOf(WinRateCallbackMarkerUtf16) >= 0;
        }

        return true;
    }

