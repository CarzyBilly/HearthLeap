    public void SetRecommendationEpoch(DateTimeOffset epoch)
    {
        // Memory callbacks do not always carry a producer timestamp.  Their
        // first-seen time is synthesized in NormalizeMemoryObservation.  Keep
        // observations captured during the current startup window, but forget
        // synthesized timestamps from an older match so an identical payload
        // in the next match can be observed again instead of being filtered as
        // historical.  Explicit callback timestamps are never rewritten.
        if (epoch > _recommendationEpoch)
        {
            foreach (string key in _memoryObservationFirstSeen
                .Where(pair => pair.Value < epoch)
                .Select(pair => pair.Key)
                .ToArray())
            {
                _memoryObservationFirstSeen.Remove(key);
            }
        }

        _recommendationEpoch = epoch;
    }

