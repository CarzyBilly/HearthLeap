    private async Task<IReadOnlyList<NeteaseBoxRecommendationObservation>> ReadCoreAsync(int desiredOptionId, bool forceFullScan, CancellationToken cancellationToken)
    {
        await _scanGate.WaitAsync(cancellationToken);
        try
        {
            ValidateBindingBeforeRead();
            RemoveExitedRenderers();
            bool captureWinRate = Volatile.Read(in _winRateCaptureEnabled) != 0;
            if (_rendererProcessIds.Count == 0 || (captureWinRate && _winRateRendererProcessIds.Count == 0))
            {
                await Task.Run((Func<bool>)DiscoverRecommendationRenderers, cancellationToken);
            }

            if (_rendererProcessIds.Count == 0)
            {
                return Array.Empty<NeteaseBoxRecommendationObservation>();
            }

            List<NeteaseBoxRecommendationObservation> observations = new List<NeteaseBoxRecommendationObservation>();
            int[] array = _rendererProcessIds.ToArray();
            foreach (int processId in array)
            {
                if (_payloadRegions.TryGetValue(processId, out HashSet<ulong> preferredRegions) && preferredRegions.Count != 0)
                {
                    RendererScanResult rendererScanResult = await Task.Run(() => ScanRenderer(processId, preferredRegions, stopAfterCallback: false, captureWinRate), cancellationToken);
                    LogRendererScanDiagnosticsIfChanged(processId, "缓存区域", rendererScanResult);
                    observations.AddRange(rendererScanResult.Observations);
                    CacheWinRateObservations(rendererScanResult.WinRateObservations);
                }
            }

            if (captureWinRate)
            {
                await RefreshWinRateMemoryAsync(cancellationToken);
            }

            CacheObservations(observations);
            IReadOnlyList<NeteaseBoxRecommendationObservation> readOnlyList = CurrentMatches(desiredOptionId);
            if (readOnlyList.Count > 0 && !forceFullScan && desiredOptionId > 0)
            {
                return readOnlyList;
            }

            if (DateTimeOffset.UtcNow - _lastRendererDiscoveryAt >= TimeSpan.FromSeconds(1.0))
            {
                _lastRendererDiscoveryAt = DateTimeOffset.UtcNow;
                await Task.Run((Func<bool>)DiscoverRecommendationRenderers, cancellationToken);
            }

            if (forceFullScan || DateTimeOffset.UtcNow - _lastFullScanAt >= TimeSpan.FromMilliseconds(400.0))
            {
                _lastFullScanAt = DateTimeOffset.UtcNow;
                observations.Clear();
                array = _rendererProcessIds.ToArray();
                foreach (int processId2 in array)
                {
                    RendererScanResult rendererScanResult2 = await Task.Run(() => ScanRenderer(processId2, null, stopAfterCallback: false, captureWinRate), cancellationToken);
                    LogRendererScanDiagnosticsIfChanged(processId2, "完整扫描", rendererScanResult2);
                    observations.AddRange(rendererScanResult2.Observations);
                    CacheWinRateObservations(rendererScanResult2.WinRateObservations);
                }

                CacheObservations(observations);
            }

            return CurrentMatches(desiredOptionId);
        }
        finally
        {
            _scanGate.Release();
        }
    }

    private IReadOnlyList<NeteaseBoxRecommendationObservation> CurrentMatches(int desiredOptionId)
    {
        DateTimeOffset oldestAccepted = DateTimeOffset.UtcNow.AddSeconds(-20.0);
        if (desiredOptionId > 0 && _latestByOptionId.TryGetValue(desiredOptionId, out List<NeteaseBoxRecommendationObservation> value))
        {
            return (
                from item in value
                where item.CapturedAt != DateTimeOffset.MinValue && item.CapturedAt >= _initializedAt.AddSeconds(-2.0) && item.CapturedAt >= _recommendationEpoch
                orderby item.CapturedAt descending
                select item).ToArray();
        }

        if (desiredOptionId > 0)
        {
            return Array.Empty<NeteaseBoxRecommendationObservation>();
        }

        return (
            from item in _latestByOptionId.Values.SelectMany((List<NeteaseBoxRecommendationObservation> items) => items)
            where item.CapturedAt != DateTimeOffset.MinValue && item.CapturedAt >= _initializedAt.AddSeconds(-2.0) && item.CapturedAt >= _recommendationEpoch && item.CapturedAt >= oldestAccepted
            orderby item.CapturedAt descending
            select item).Take(24).ToArray();
    }

    private void CacheObservations(IEnumerable<NeteaseBoxRecommendationObservation> observations)
    {
        foreach (NeteaseBoxRecommendationObservation observation2 in observations)
        {
            NeteaseBoxRecommendationObservation observation = NormalizeMemoryObservation(observation2);
            if (!_latestByOptionId.TryGetValue(observation.Payload.OptionId, out List<NeteaseBoxRecommendationObservation> value))
            {
                value = new List<NeteaseBoxRecommendationObservation>();
                _latestByOptionId[observation.Payload.OptionId] = value;
            }

            if (!value.Any((NeteaseBoxRecommendationObservation item) => item.RendererProcessId == observation.RendererProcessId && item.Address == observation.Address && item.CapturedAt == observation.CapturedAt))
            {
                value.Add(observation);
                value.Sort((NeteaseBoxRecommendationObservation left, NeteaseBoxRecommendationObservation right) => right.CapturedAt.CompareTo(left.CapturedAt));
                if (value.Count > 12)
                {
                    value.RemoveRange(12, value.Count - 12);
                }
            }
        }
    }

    private async Task RefreshWinRateMemoryAsync(CancellationToken cancellationToken)
    {
        int[] array;
        if (DateTimeOffset.UtcNow - _lastWinRateScanAt >= TimeSpan.FromSeconds(1.0))
        {
            _lastWinRateScanAt = DateTimeOffset.UtcNow;
            array = _winRateRendererProcessIds.ToArray();
            foreach (int processId in array)
            {
                if (_winRateRegions.TryGetValue(processId, out HashSet<ulong> preferredRegions) && preferredRegions.Count != 0)
                {
                    CacheWinRateObservations((await Task.Run(() => ScanRenderer(processId, preferredRegions, stopAfterCallback: false, captureWinRate: true), cancellationToken)).WinRateObservations);
                }
            }
        }

        if (DateTimeOffset.UtcNow - _lastWinRateRelocationScanAt < TimeSpan.FromSeconds(30.0))
        {
            return;
        }

        _lastWinRateRelocationScanAt = DateTimeOffset.UtcNow;
        array = _winRateRendererProcessIds.ToArray();
        foreach (int processId2 in array)
        {
            CacheWinRateObservations((await Task.Run(() => ScanRenderer(processId2, null, stopAfterCallback: false, captureWinRate: true), cancellationToken)).WinRateObservations);
        }
    }

    private void CacheWinRateObservations(IEnumerable<NeteaseBoxWinRateObservation> observations)
    {
        foreach (NeteaseBoxWinRateObservation observation2 in observations)
        {
            bool flag = !double.IsFinite(observation2.Payload.MyWinRate);
            if (!flag)
            {
                double myWinRate = observation2.Payload.MyWinRate;
                bool flag2 = ((myWinRate < 0.0 || myWinRate > 100.0) ? true : false);
                flag = flag2;
            }

            if (flag)
            {
                continue;
            }

            IFormatProvider invariantCulture = CultureInfo.InvariantCulture;
            DefaultInterpolatedStringHandler handler = new DefaultInterpolatedStringHandler(13, 6, invariantCulture);
            handler.AppendLiteral("winrate|");
            handler.AppendFormatted(observation2.RendererProcessId);
            handler.AppendLiteral("|");
            handler.AppendFormatted(observation2.Address, "X");
            handler.AppendLiteral("|");
            handler.AppendFormatted(observation2.Payload.MyWinRate, "R");
            handler.AppendLiteral("|");
            handler.AppendFormatted(observation2.Payload.Turns.LastOrDefault()?.TurnId ?? 0);
            handler.AppendLiteral("|");
            handler.AppendFormatted(observation2.Payload.MyPlayer?.Name);
            handler.AppendLiteral("|");
            handler.AppendFormatted(observation2.Payload.OpponentPlayer?.Name);
            string key = string.Create(invariantCulture, ref handler);
            if (!_memoryObservationFirstSeen.TryGetValue(key, out var value))
            {
                value = DateTimeOffset.UtcNow;
                _memoryObservationFirstSeen[key] = value;
                if (_enableDiagnostics)
                {
                    NeteaseBoxWinRateTurn neteaseBoxWinRateTurn = observation2.Payload.Turns.LastOrDefault();
                    Log?.Invoke($"盒子AI胜率候选：PID={observation2.RendererProcessId}，地址=0x{observation2.Address:X}，回合={neteaseBoxWinRateTurn?.TurnId ?? 0}，胜率={observation2.Payload.MyWinRate:0.####}%，时间={neteaseBoxWinRateTurn?.Timestamp ?? ""}，历史点={observation2.Payload.Turns.Count}。");
                }
            }

            NeteaseBoxWinRateObservation observation = ((observation2.CapturedAt == DateTimeOffset.MinValue) ? observation2 with
            {
                CapturedAt = value
            }

            : observation2);
            if (!_latestWinRates.Any((NeteaseBoxWinRateObservation item) => item.RendererProcessId == observation.RendererProcessId && item.Address == observation.Address && item.CapturedAt == observation.CapturedAt && Math.Abs(item.Payload.MyWinRate - observation.Payload.MyWinRate) < 1E-06))
            {
                _latestWinRates.Add(observation);
            }
        }

        _latestWinRates.Sort((NeteaseBoxWinRateObservation left, NeteaseBoxWinRateObservation right) =>
        {
            int num = right.CapturedAt.CompareTo(left.CapturedAt);
            if (num != 0)
            {
                return num;
            }

