    private NeteaseBoxBindingAssessment ObserveCurrentBinding(string boxExecutablePath, int targetProcessId)
    {
        using ProcessCollection processes = new ProcessCollection(Process.GetProcessesByName("HSAng"));
        var alive = processes.Processes.Where(candidate => !SafeHasExited(candidate)).ToArray();
        if (alive.Length > 1)
        {
            lock (VerifiedBindingGate) _lastVerifiedBinding = null;
            return new(NeteaseBoxBindingVerdict.Conflict, "检测到多个盒子进程，无法确认推荐属于哪个客户端；请保留一个盒子后重试。");
        }
        NeteaseBoxProcessSession box = null;
        if (alive.Length == 1)
        {
            try
            {
                var path = TryGetProcessPath(alive[0]);
                if (!string.IsNullOrWhiteSpace(path) && string.Equals(path, boxExecutablePath, StringComparison.OrdinalIgnoreCase))
                    box = new(alive[0].Id, alive[0].StartTime.ToUniversalTime().Ticks, path);
            }
            catch (Exception ex) when (ex is System.ComponentModel.Win32Exception or InvalidOperationException or UnauthorizedAccessException) { }
        }
        var clients = NeteaseBoxTargetBinding.SnapshotLiveClients();
        var helper = NeteaseBoxTargetBinding.ReadLatestHelperTarget(Path.Combine(Path.GetDirectoryName(boxExecutablePath) ?? "", "heart_helper.log"));
        NeteaseBoxVerifiedSession verified;
        lock (VerifiedBindingGate) verified = _lastVerifiedBinding;
        var assessment = NeteaseBoxBindingEvidence.Assess(targetProcessId, box, clients, helper, verified, DateTimeOffset.UtcNow);
        // Once new/conflicting/unreadable evidence invalidates a proof, a later missing log cannot revive it.
        if (assessment.Verdict != NeteaseBoxBindingVerdict.Verified)
        {
            lock (VerifiedBindingGate)
                if (ReferenceEquals(_lastVerifiedBinding, verified)) _lastVerifiedBinding = null;
        }
        return assessment;
    }

    private static void RememberBinding(NeteaseBoxBindingAssessment assessment)
    {
        if (assessment.Verdict != NeteaseBoxBindingVerdict.Verified || assessment.Session == null)
            throw new InvalidOperationException("连接证据尚未核实，不能读取推荐。");
        lock (VerifiedBindingGate) _lastVerifiedBinding = assessment.Session;
    }

