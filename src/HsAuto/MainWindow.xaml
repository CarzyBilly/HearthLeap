<Window x:Class="HsAuto.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" Title="HearthLeap" Icon="Assets/LegendRush.ico" Width="1160" Height="810" MinWidth="960" MinHeight="700" WindowStartupLocation="CenterScreen" WindowStyle="None" Background="#F4F7FC" FontFamily="Microsoft YaHei UI" Foreground="{StaticResource Ink}" UseLayoutRounding="True" SnapsToDevicePixels="True">
 <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="56" CornerRadius="24" GlassFrameThickness="0" ResizeBorderThickness="6"/></shell:WindowChrome.WindowChrome>
 <Grid ClipToBounds="True">
  <Grid IsHitTestVisible="False"><Grid.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#EDF0F7FF" Offset="0"/><GradientStop Color="#EDE2ECF8" Offset="0.5"/><GradientStop Color="#EDF5EDF7" Offset="1"/></LinearGradientBrush></Grid.Background><Ellipse Width="620" Height="540" Fill="#85BBF2E9" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-110,-150,0"><Ellipse.Effect><BlurEffect Radius="90"/></Ellipse.Effect></Ellipse><Ellipse Width="460" Height="450" Fill="#76C1ABF8" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-80,0,0,-100"><Ellipse.Effect><BlurEffect Radius="80"/></Ellipse.Effect></Ellipse></Grid>
  <Grid Margin="22,12,22,22"><Grid.RowDefinitions><RowDefinition Height="52"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <Grid><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Image Source="Assets/LegendRush.png" Width="34" Height="34" Margin="0,0,11,0"/><TextBlock x:Name="BrandTitle" Text="HearthLeap" FontSize="19" FontWeight="Bold" VerticalAlignment="Center"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" shell:WindowChrome.IsHitTestVisibleInChrome="True"><Button Content="─" Click="MinimizeClick" Padding="12,6" Margin="0,6,7,6" MinHeight="30"/><Button Content="□" Click="MaximizeClick" Padding="12,6" Margin="0,6,7,6" MinHeight="30"/><Button Content="×" Click="CloseClick" Padding="12,6" Margin="0,6,0,6" MinHeight="30"/></StackPanel></Grid>
   <Grid Grid.Row="1" Margin="0,6,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <!-- Measure the button height plus its glow/scale gutter instead of constraining a 42-DIP button inside a 38-DIP slot. -->
    <Border x:Name="NavigationCard" Style="{StaticResource Card}" Padding="14,12" Margin="0,0,0,8" ClipToBounds="False"><UniformGrid x:Name="NavigationLayout" Columns="3" ClipToBounds="False"><Button x:Name="AccountNav" Style="{StaticResource NavigationButton}" Content="◈  玩家档案" Tag="Account" Click="NavClick"/><Button x:Name="StatsNav" Style="{StaticResource NavigationButton}" Content="▥  对战分析" Tag="Stats" Click="NavClick"/><Button x:Name="SettingsNav" Style="{StaticResource NavigationButton}" Content="⚙  引擎设置" Tag="Settings" Click="NavClick"/></UniformGrid></Border>
    <Grid Grid.Row="1"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition x:Name="LogRow" Height="110"/></Grid.RowDefinitions>
     <Grid Margin="4,0,0,8"><StackPanel><TextBlock x:Name="PageTitle" Text="玩家档案" FontSize="25" FontWeight="Bold"/><TextBlock x:Name="PageSubtitle" Text="连接你的游戏，保持操作简单。" Style="{StaticResource Muted}" Margin="0,6,0,0"/></StackPanel><StackPanel x:Name="EngineActionPanel" Visibility="Collapsed" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><Button x:Name="InspectButton" Content="重新检测" Click="InspectClick" Margin="0,0,8,0"/><Button x:Name="StartButton" Content="▶  开始脚本" Click="StartClick" Style="{StaticResource Primary}"/><Button x:Name="StopButton" Content="■  停止" Click="StopClick" Margin="8,0,0,0" IsEnabled="False"/></StackPanel></Grid>
     <Border x:Name="EngineStatusPanel" Visibility="Collapsed" Grid.Row="1" Style="{StaticResource Card}" Padding="20,9" Margin="0,0,0,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="01 / 炉石盒子" Style="{StaticResource Muted}"/><TextBlock x:Name="BoxStatus" Text="检测中" FontWeight="SemiBold" Margin="0,7,0,0"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="02 / 炉石传说" Style="{StaticResource Muted}"/><TextBlock x:Name="GameStatus" Text="等待启动" FontWeight="SemiBold" Margin="0,7,0,0"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="03 / UnityBridge" Style="{StaticResource Muted}"/><TextBlock x:Name="BridgeStatus" Text="尚未连接" FontWeight="SemiBold" Margin="0,7,0,0"/></StackPanel><StackPanel Grid.Column="3"><TextBlock Text="04 / 运行状态" Style="{StaticResource Muted}"/><TextBlock x:Name="RunStatus" Text="准备就绪" FontWeight="SemiBold" Margin="0,7,0,0"/></StackPanel></Grid></Border>
     <Grid Grid.Row="2" x:Name="PageHost">
      <ScrollViewer x:Name="AccountPage" VerticalScrollBarVisibility="Auto"><StackPanel>
       <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.25*"/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="当前游戏账号" Style="{StaticResource Muted}"/><TextBlock x:Name="AccountName" Text="等待账号信息" TextWrapping="Wrap" FontSize="25" FontWeight="SemiBold" Margin="0,12,0,4"/><TextBlock x:Name="AccountSummary" Text="通过正常的战网流程登录。" Style="{StaticResource Muted}" Margin="0,0,0,20"/><TextBlock x:Name="IdentityHint" Text="登录炉石并连接插件后自动识别，无需手动填写。" Style="{StaticResource Muted}"/></StackPanel></Border>
        <Border Grid.Column="2" Style="{StaticResource Card}"><StackPanel><TextBlock Text="对局现场" Style="{StaticResource Muted}"/><TextBlock x:Name="MatchPhase" Text="—" FontSize="24" FontWeight="SemiBold" Margin="0,12,0,4"/><TextBlock x:Name="MatchInfo" Text="尚未读取游戏状态" Style="{StaticResource Muted}" Margin="0,0,0,24"/><TextBlock Text="最近推荐 / 操作" Style="{StaticResource Muted}"/><TextBlock x:Name="Recommendation" Text="连接盒子后，推荐会显示在这里。" TextWrapping="Wrap" Margin="0,8,0,0" FontSize="13"/></StackPanel></Border>
       </Grid>
      </StackPanel></ScrollViewer>
      <ScrollViewer x:Name="StatsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel>
       <UniformGrid Columns="3" Margin="0,0,0,16"><Border Style="{StaticResource Card}" Margin="0,0,10,0"><StackPanel><TextBlock Text="已完成对局" Style="{StaticResource Muted}"/><TextBlock x:Name="MatchCount" Text="0" FontSize="36" FontWeight="Bold" Margin="0,8,0,0"/></StackPanel></Border><Border Style="{StaticResource Card}" Margin="0,0,10,0"><StackPanel><TextBlock Text="胜 / 负" Style="{StaticResource Muted}"/><TextBlock x:Name="WinLoss" Text="0 / 0" FontSize="36" FontWeight="Bold" Margin="0,8,0,0"/></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="胜率" Style="{StaticResource Muted}"/><TextBlock x:Name="WinRate" Text="—" FontSize="36" FontWeight="Bold" Margin="0,8,0,0"/></StackPanel></Border></UniformGrid>
       <Border Style="{StaticResource Card}"><StackPanel><Grid><TextBlock Text="最近对局" FontWeight="SemiBold" FontSize="16"/><Button Content="导出 CSV" Click="ExportClick" HorizontalAlignment="Right" Padding="14,7" MinHeight="34"/></Grid><TextBlock x:Name="EmptyHistory" Text="还没有战绩。完成对局后自动记录，不填充示例数据。" Style="{StaticResource Muted}" Margin="0,20,0,12"/><ItemsControl x:Name="History"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="#E4EAF2" BorderThickness="0,0,0,1" Padding="4,12"><TextBlock Text="{Binding}" FontSize="13"/></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
      </StackPanel></ScrollViewer>
      <Grid x:Name="SettingsPage" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition/><RowDefinition Height="52"/></Grid.RowDefinitions>
       <StackPanel Orientation="Horizontal"><Button x:Name="BasicSettingsNav" Content="常用设置" Tag="Basic" Click="SettingsTabClick" Padding="16,7" MinHeight="32" Margin="0,0,8,8"/><Button x:Name="TraditionalSettingsNav" Content="投降与轮换" Tag="Traditional" Click="SettingsTabClick" Padding="16,7" MinHeight="32" Margin="0,0,8,8"/><Button x:Name="RankSettingsNav" Content="段位与恢复" Tag="Rank" Click="SettingsTabClick" Padding="16,7" MinHeight="32" Margin="0,0,8,8"/><Button x:Name="TimeSettingsNav" Content="时间设置" Tag="Time" Click="SettingsTabClick" Padding="16,7" MinHeight="32" Margin="0,0,8,8"/><TextBlock Text="下次启动生效" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="10,0,0,8"/></StackPanel>
       <Grid Grid.Row="1" x:Name="BasicSettingsPanel"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <Border Style="{StaticResource Card}" Padding="20,12"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="运行偏好" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,6"/><UniformGrid Columns="2"><CheckBox x:Name="AutoBox" Margin="0,3" Content="自动打开炉石盒子"/><CheckBox x:Name="AutoQueue" Margin="0,3" Content="自动进入下一局"/><CheckBox x:Name="ReadOnly" Margin="0,3" Content="只读观察，不操作"/></UniformGrid><TextBlock Text="传统对战模式" Style="{StaticResource Muted}" Margin="0,8,0,5"/><ComboBox x:Name="FormatCombo" Height="32" SelectedIndex="0" SelectionChanged="FormatChanged"><ComboBoxItem Content="标准" Tag="Standard"/><ComboBoxItem Content="狂野" Tag="Wild"/><ComboBoxItem Content="休闲" Tag="Casual"/></ComboBox><TextBlock Text="卡组名称 · 可选择，也可直接输入" Style="{StaticResource Muted}" Margin="0,10,0,5"/><DockPanel><Button x:Name="DeckRefreshButton" Content="刷新" Click="RefreshDecksClick" DockPanel.Dock="Right" Padding="12,5" MinHeight="32" Margin="8,0,0,0" ToolTip="只读取游戏内完整卡组，不切换场景或套牌"/><ComboBox x:Name="DeckBox" IsEditable="True" IsTextSearchEnabled="True" StaysOpenOnEdit="True" Height="34" MaxDropDownHeight="240"/></DockPanel><TextBlock x:Name="DeckHint" Text="游戏和插件就绪后自动读取，识别失败仍可手动输入。" Style="{StaticResource Muted}" Margin="0,8,0,0"/></StackPanel></ScrollViewer></Border>
        <Border Grid.Column="2" Style="{StaticResource Card}" Padding="20,12"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="安装与连接" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="炉石盒子" Style="{StaticResource Muted}" Margin="0,12,0,4"/><DockPanel><Button Content="定位" Click="BrowseBoxClick" DockPanel.Dock="Right" Padding="12,5" MinHeight="32" Margin="8,0,0,0"/><TextBox x:Name="BoxPathBox" MinHeight="36" Padding="10,4" VerticalContentAlignment="Center" HorizontalScrollBarVisibility="Hidden" ToolTip="{Binding Text,RelativeSource={RelativeSource Self}}"/></DockPanel><TextBlock x:Name="GameInstallLabel" Text="炉石传说" Style="{StaticResource Muted}" Margin="0,10,0,4"/><DockPanel><Button Content="定位" Click="BrowseGameClick" DockPanel.Dock="Right" Padding="12,5" MinHeight="32" Margin="8,0,0,0"/><TextBox x:Name="GamePathBox" MinHeight="36" Padding="10,4" VerticalContentAlignment="Center" HorizontalScrollBarVisibility="Hidden" ToolTip="{Binding Text,RelativeSource={RelativeSource Self}}"/></DockPanel><UniformGrid Columns="2" Margin="0,12,0,0"><Button Content="安装/修复插件" Click="InstallClick" Padding="10,8" MinHeight="36" Margin="0,0,8,0"/><Button Content="删除插件" Click="DeletePluginClick" Padding="10,8" MinHeight="36"/></UniformGrid><TextBlock Text="操作前请退出炉石。只删除本项目插件，保留 BepInEx、其他插件和历史备份。" Style="{StaticResource Muted}" Margin="0,10,0,0"/></StackPanel></ScrollViewer></Border>
       </Grid>
       <ScrollViewer Grid.Row="1" x:Name="TraditionalPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="使用盒子已提供的推荐；不包含 AI 3.0 第三方直连接口。所有控制默认关闭。" Style="{StaticResource Muted}" Margin="4,0,0,8"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <Border Style="{StaticResource Card}" Padding="18,12"><StackPanel><TextBlock Text="投降与保护" FontWeight="SemiBold"/><UniformGrid Columns="2"><CheckBox x:Name="AutoConcedeBox" Content="自动投降"/><CheckBox x:Name="RopeProtectionBox" Content="卡住烧绳投降保护"/></UniformGrid><StackPanel Orientation="Horizontal"><CheckBox x:Name="WinPatternBox" Content="赢" Margin="0,6,4,6"/><TextBox x:Name="WinsBox" Text="1" Width="48" Padding="6" Margin="0,4,5,4"/><TextBlock Text="场，投" VerticalAlignment="Center"/><TextBox x:Name="ConcedesBox" Text="1" Width="48" Padding="6" Margin="5,4"/><TextBlock Text="场" VerticalAlignment="Center"/></StackPanel><StackPanel Orientation="Horizontal"><CheckBox x:Name="LowWinRateBox" Content="盒子胜率低于" Margin="0,6,5,6"/><TextBox x:Name="WinRateThresholdBox" Text="20" Width="52" Padding="6" Margin="0,4,5,4"/><TextBlock Text="% 投降" VerticalAlignment="Center"/></StackPanel><TextBlock Text="只采用当前回合的新鲜胜率；未知胜率不投降。连续 3 局烧绳保护会停止。" Style="{StaticResource Muted}" Margin="0,5,0,0"/></StackPanel></Border>
        <Border Grid.Column="2" Style="{StaticResource Card}" Padding="18,12"><StackPanel><TextBlock Text="卡组轮换" FontWeight="SemiBold"/><StackPanel Orientation="Horizontal"><CheckBox x:Name="RotateDecksBox" Content="每" Margin="0,8,5,8"/><TextBox x:Name="RotateEveryBox" Text="1" Width="54" Padding="6" Margin="0,6,5,6"/><TextBlock Text="局轮换卡组" VerticalAlignment="Center"/></StackPanel><TextBlock Text="轮换卡组名称（用逗号分隔）" Style="{StaticResource Muted}" Margin="0,4,0,5"/><TextBox x:Name="RotationNamesBox" Padding="10,7"/><TextBlock Text="留空 = 当前模式全部已识别的完整卡组；至少两副。只在两局之间换牌，不自动补全卡组。" Style="{StaticResource Muted}" Margin="0,9,0,0"/></StackPanel></Border>
       </Grid></StackPanel></ScrollViewer>
       <ScrollViewer Grid.Row="1" x:Name="RankPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <Border Style="{StaticResource Card}" Padding="18,12"><StackPanel><TextBlock Text="段位与停止" FontWeight="SemiBold"/><DockPanel><CheckBox x:Name="StopAtRankBox" Content="达到段位停止" Margin="0,8,8,8"/><ComboBox x:Name="StopRankCombo" Height="32" MinWidth="110"/></DockPanel><DockPanel><CheckBox x:Name="ControlRankBox" Content="控制分段" Margin="0,8,8,8"/><ComboBox x:Name="ControlRankCombo" Height="32" MinWidth="110"/></DockPanel><StackPanel Orientation="Horizontal"><CheckBox x:Name="LegendStopBox" Content="传说排名 ≤" Margin="0,8,5,8"/><TextBox x:Name="LegendThresholdBox" Text="30000" Width="85" Padding="6"/><TextBlock Text="名停止" VerticalAlignment="Center" Margin="5,0,0,0"/></StackPanel><TextBlock Text="停止条件在匹配前检查，不中断已进行的对局；休闲模式不支持段位控制。" Style="{StaticResource Muted}" Margin="0,6,0,0"/></StackPanel></Border>
        <Border Grid.Column="2" Style="{StaticResource Card}" Padding="18,12"><StackPanel><TextBlock Text="推荐恢复" FontWeight="SemiBold"/><CheckBox x:Name="RestartBoxToggle" Content="推荐未更新时额外恢复"/><StackPanel Orientation="Horizontal"><TextBlock Text="无推荐等待" VerticalAlignment="Center"/><TextBox x:Name="NoRecommendationBox" Text="15" Width="62" Padding="6" Margin="8,0,5,0"/><TextBlock Text="秒" VerticalAlignment="Center"/></StackPanel><StackPanel Orientation="Horizontal" Margin="0,10,0,0"><TextBlock Text="重启间隔" VerticalAlignment="Center"/><TextBox x:Name="RestartCooldownBox" Text="120" Width="62" Padding="6" Margin="20,0,5,0"/><TextBlock Text="秒" VerticalAlignment="Center"/></StackPanel><TextBlock Text="错误持续3秒自动重连，连续3次未恢复再重启盒子。正常等待对手不会触发。只读模式不重启盒子。" Style="{StaticResource Muted}" Margin="0,10,0,0"/></StackPanel></Border>
       </Grid></ScrollViewer>
       <ScrollViewer Grid.Row="1" x:Name="TimePanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
         <Border Style="{StaticResource Card}" Padding="20,16"><StackPanel>
          <TextBlock Text="定时停止挂机" FontSize="16" FontWeight="SemiBold"/>
          <CheckBox x:Name="TimedStopBox" Content="启用定时停止" Margin="0,8,0,10"/>
          <StackPanel Orientation="Horizontal"><TextBox x:Name="StopAfterHoursBox" Text="0" Width="70" Padding="10,7"/><TextBlock Text="小时" VerticalAlignment="Center" Margin="8,0,14,0"/><TextBox x:Name="StopAfterMinutesBox" Text="0" Width="70" Padding="10,7"/><TextBlock Text="分钟后停止" VerticalAlignment="Center" Margin="8,0,0,0"/></StackPanel>
          <TextBlock Text="小时 0～168，分钟 0～59；启用后至少设置 1 分钟。" Style="{StaticResource Muted}" Margin="0,10,0,12"/>
          <TextBlock Text="停止后的操作" Style="{StaticResource Muted}" Margin="0,0,0,5"/>
          <ComboBox x:Name="TimedStopActionCombo" Height="36" SelectedIndex="0"><ComboBoxItem Content="仅停止脚本" Tag="StopOnly"/><ComboBoxItem Content="退出炉石" Tag="ExitGame"/><ComboBoxItem Content="退出炉石、战网和炉石盒子" Tag="ExitGameAndClients"/><ComboBoxItem Content="停止后关机" Tag="Shutdown"/></ComboBox>
         </StackPanel></Border>
         <Border Grid.Column="2" Style="{StaticResource Card}" Padding="20,16"><StackPanel>
          <TextBlock Text="当前计时" FontSize="16" FontWeight="SemiBold"/>
          <TextBlock x:Name="TimedStopCountdown" Text="未启用定时停止" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,16,0,8"/>
          <TextBlock x:Name="TimedStopHint" Text="点击“开始脚本”后开始计时，保存设置不会开始倒计时。" Style="{StaticResource Muted}" Margin="0,0,0,12"/>
          <Button x:Name="CancelTimedStopButton" Content="取消本次定时操作" Click="CancelTimedStopClick" IsEnabled="False" HorizontalAlignment="Left" Padding="16,8" MinHeight="36"/>
          <Button x:Name="ImmediateStopButton" Content="立即停止并执行所选操作" Click="ImmediateStopClick" IsEnabled="False" HorizontalAlignment="Left" Padding="16,8" MinHeight="36" Margin="0,10,0,0"/>
          <TextBlock Text="“停止”仅停止脚本并取消后续操作；“立即停止并执行所选操作”无需启用定时或等待倒计时。先保存设置与战绩，无法安全退出或保存失败时不关机。关机前有 30 秒缓冲，可随时取消。" Style="{StaticResource Muted}" Margin="0,14,0,0"/>
         </StackPanel></Border>
        </Grid>
       </ScrollViewer>
       <Grid Grid.Row="2" Margin="0,10,0,0"><Button x:Name="SaveSettingsButton" Content="保存设置" Click="SaveSettingsClick" Style="{StaticResource Primary}" HorizontalAlignment="Left" Padding="20,8" MinHeight="36"/><Button Content="打开日志文件夹" Click="OpenLogsClick" HorizontalAlignment="Right" Padding="16,8" MinHeight="36"/></Grid>
      </Grid>
     </Grid>
     <Border x:Name="EngineLogPanel" Grid.Row="3" Style="{StaticResource Card}" Padding="18,12" Margin="0,12,0,0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid><TextBlock Text="运行日志" FontWeight="SemiBold" FontSize="12"/><TextBlock x:Name="StatusNote" Text="" Style="{StaticResource Muted}" HorizontalAlignment="Right"/></Grid><TextBox Grid.Row="1" x:Name="LogBox" IsReadOnly="True" TextWrapping="Wrap" Background="Transparent" BorderThickness="0" Padding="0,10,0,0" VerticalScrollBarVisibility="Auto" FontFamily="Consolas, Microsoft YaHei UI" FontSize="11"/></Grid></Border>
    </Grid>
   </Grid>
  </Grid>
 </Grid>
</Window>


