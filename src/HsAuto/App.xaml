<Application x:Class="HsAuto.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:HsAuto">
 <Application.Resources>
  <SolidColorBrush x:Key="Ink" Color="#17283E"/><SolidColorBrush x:Key="MutedBrush" Color="#60738B"/>
  <SolidColorBrush x:Key="Accent" Color="#286DDB"/><SolidColorBrush x:Key="Glass" Color="#ACFFFFFF"/>
  <Style TargetType="TextBlock"><Setter Property="FontSize" Value="14"/></Style>
  <Style x:Key="Muted" TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource MutedBrush}"/><Setter Property="FontSize" Value="12"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style x:Key="Card" TargetType="Border">
   <Setter Property="Background" Value="{StaticResource Glass}"/><Setter Property="CornerRadius" Value="24"/><Setter Property="Padding" Value="24"/><Setter Property="BorderThickness" Value="1"/><Setter Property="BorderBrush" Value="#E5FFFFFF"/>
   <Setter Property="Effect"><Setter.Value><DropShadowEffect Color="#647B9A" BlurRadius="24" ShadowDepth="6" Opacity="0.08"/></Setter.Value></Setter>
  </Style>
  <Style TargetType="Button">
   <Setter Property="Cursor" Value="Hand"/><Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Padding" Value="18,12"/><Setter Property="Background" Value="#AFFFFFFF"/><Setter Property="BorderBrush" Value="#F5FFFFFF"/><Setter Property="BorderThickness" Value="1"/><Setter Property="MinHeight" Value="42"/><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Grid x:Name="surface" RenderTransformOrigin="0.5,0.5" ClipToBounds="False" SnapsToDevicePixels="True">
     <Grid.RenderTransform><ScaleTransform ScaleX="1" ScaleY="1"/></Grid.RenderTransform>
     <Border x:Name="body" CornerRadius="15" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"><Border.Effect><DropShadowEffect Color="#506789" BlurRadius="14" ShadowDepth="3" Opacity="0.08"/></Border.Effect></Border>
     <Border x:Name="hoverGlow" CornerRadius="15" Opacity="0" Background="#357FC9FF" BorderBrush="#849BCCFF" BorderThickness="1" IsHitTestVisible="False"><Border.Effect><DropShadowEffect Color="#5B92F3" BlurRadius="18" ShadowDepth="0" Opacity="0.45"/></Border.Effect></Border>
     <Border x:Name="sheen" CornerRadius="15" Opacity="0.16" IsHitTestVisible="False"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0.7,1"><GradientStop Color="White" Offset="0"/><GradientStop Color="#00FFFFFF" Offset="0.6"/><GradientStop Color="White" Offset="1"/></LinearGradientBrush></Border.Background></Border>
     <Border x:Name="sweep" CornerRadius="15" Opacity="0" IsHitTestVisible="False"><Border.Background><LinearGradientBrush x:Name="sweepBrush" StartPoint="0,0" EndPoint="1,0"><LinearGradientBrush.RelativeTransform><TranslateTransform X="-1"/></LinearGradientBrush.RelativeTransform><GradientStop Color="#00FFFFFF" Offset="0.1"/><GradientStop Color="#9FFFFFFF" Offset="0.45"/><GradientStop Color="#00FFFFFF" Offset="0.8"/></LinearGradientBrush></Border.Background></Border>
     <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" Margin="{TemplateBinding Padding}"/>
    </Grid>
    <ControlTemplate.Triggers>
     <MultiTrigger><MultiTrigger.Conditions><Condition Property="IsMouseOver" Value="True"/><Condition Property="IsEnabled" Value="True"/><Condition Property="local:MotionSettings.Enabled" Value="True"/></MultiTrigger.Conditions>
      <MultiTrigger.EnterActions><RemoveStoryboard BeginStoryboardName="HoverExit"/><BeginStoryboard x:Name="HoverEntry"><Storyboard><DoubleAnimation Storyboard.TargetName="sheen" Storyboard.TargetProperty="Opacity" To="0.50" Duration="0:0:0.18"/></Storyboard></BeginStoryboard><BeginStoryboard x:Name="HoverPulse"><Storyboard><DoubleAnimation Storyboard.TargetName="hoverGlow" Storyboard.TargetProperty="Opacity" From="0.18" To="0.6" Duration="0:0:1.2" AutoReverse="True" RepeatBehavior="Forever"/><DoubleAnimation Storyboard.TargetName="sweep" Storyboard.TargetProperty="Opacity" From="0.32" To="0.12" Duration="0:0:2.1" RepeatBehavior="Forever"/><DoubleAnimation Storyboard.TargetName="sweepBrush" Storyboard.TargetProperty="(Brush.RelativeTransform).(TranslateTransform.X)" From="-1" To="1.1" Duration="0:0:2.1" RepeatBehavior="Forever"/></Storyboard></BeginStoryboard></MultiTrigger.EnterActions>
      <MultiTrigger.ExitActions><RemoveStoryboard BeginStoryboardName="HoverEntry"/><RemoveStoryboard BeginStoryboardName="HoverPulse"/><BeginStoryboard x:Name="HoverExit"><Storyboard><DoubleAnimation Storyboard.TargetName="surface" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.16" FillBehavior="Stop"/><DoubleAnimation Storyboard.TargetName="surface" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.16" FillBehavior="Stop"/></Storyboard></BeginStoryboard></MultiTrigger.ExitActions>
     </MultiTrigger>
     <MultiTrigger><MultiTrigger.Conditions><Condition Property="IsPressed" Value="True"/><Condition Property="local:MotionSettings.Enabled" Value="True"/></MultiTrigger.Conditions><MultiTrigger.EnterActions><RemoveStoryboard BeginStoryboardName="Release"/><BeginStoryboard x:Name="Press"><Storyboard><DoubleAnimation Storyboard.TargetName="surface" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="0.98" Duration="0:0:0.07"/><DoubleAnimation Storyboard.TargetName="surface" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="0.98" Duration="0:0:0.07"/></Storyboard></BeginStoryboard></MultiTrigger.EnterActions><MultiTrigger.ExitActions><RemoveStoryboard BeginStoryboardName="Press"/><BeginStoryboard x:Name="Release"><Storyboard><DoubleAnimation Storyboard.TargetName="surface" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.2" FillBehavior="Stop"></DoubleAnimation><DoubleAnimation Storyboard.TargetName="surface" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.2" FillBehavior="Stop"/></Storyboard></BeginStoryboard></MultiTrigger.ExitActions></MultiTrigger>
     <Trigger Property="local:MotionSettings.Enabled" Value="False"><Trigger.EnterActions><RemoveStoryboard BeginStoryboardName="HoverEntry"/><RemoveStoryboard BeginStoryboardName="HoverPulse"/><RemoveStoryboard BeginStoryboardName="HoverExit"/><RemoveStoryboard BeginStoryboardName="Press"/><RemoveStoryboard BeginStoryboardName="Release"/></Trigger.EnterActions></Trigger>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="body" Property="BorderBrush" Value="#9CBCEB"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="body" Property="BorderBrush" Value="#4E86DF"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="surface" Property="Opacity" Value="0.4"/><Setter Property="Cursor" Value="Arrow"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <!-- Navigation owns an explicit 44-DIP face; its parent measures a separate 12-DIP animation gutter. -->
  <Style x:Key="NavigationButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Padding" Value="18,8"/><Setter Property="MinHeight" Value="44"/><Setter Property="FontSize" Value="15"/><Setter Property="Margin" Value="6,0"/><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="ClipToBounds" Value="False"/></Style>
  <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="#286DDB"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#9DCAFF"/></Style>
  <Style TargetType="TextBox"><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Padding" Value="12,10"/><Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="Background" Value="#CFFFFFFF"/><Setter Property="BorderBrush" Value="#E2E8F1"/><Setter Property="BorderThickness" Value="1"/><Setter Property="FontSize" Value="13"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Border x:Name="edge" CornerRadius="12" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"><ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/></Border><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="edge" Property="BorderBrush" Value="#729EEA"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="ComboBox"><Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="FontSize" Value="13"/><Setter Property="Background" Value="#CFFFFFFF"/><Setter Property="BorderBrush" Value="#E2E8F1"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="10,5"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid>
   <Border x:Name="comboEdge" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="11"/>
   <ToggleButton x:Name="toggle" Focusable="False" IsChecked="{Binding IsDropDownOpen,RelativeSource={RelativeSource TemplatedParent},Mode=TwoWay}"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border x:Name="arrowHover" Background="Transparent" CornerRadius="10"><TextBlock Text="⌄" FontSize="18" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,3"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="arrowHover" Property="Background" Value="#2279AFFF"/></Trigger></ControlTemplate.Triggers></ControlTemplate></ToggleButton.Template></ToggleButton>
   <ContentPresenter x:Name="selected" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" Margin="10,4,32,4" IsHitTestVisible="False" VerticalAlignment="Center"/>
   <TextBox x:Name="PART_EditableTextBox" Visibility="Collapsed" Background="Transparent" BorderThickness="0" Padding="0" Margin="10,4,32,4" VerticalContentAlignment="Center" IsReadOnly="{TemplateBinding IsReadOnly}"><TextBox.Template><ControlTemplate TargetType="TextBox"><ScrollViewer x:Name="PART_ContentHost"/></ControlTemplate></TextBox.Template></TextBox>
   <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="None"><Border Background="#FAFFFFFF" BorderBrush="#C2D3EB" BorderThickness="1" CornerRadius="12" Padding="6" MinWidth="{Binding ActualWidth,RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="{TemplateBinding MaxDropDownHeight}"><ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Auto"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer></Border></Popup>
  </Grid><ControlTemplate.Triggers><Trigger Property="IsEditable" Value="True"><Setter TargetName="selected" Property="Visibility" Value="Collapsed"/><Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/></Trigger><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="comboEdge" Property="BorderBrush" Value="#729EEA"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="comboEdge" Property="BorderBrush" Value="#9CBCEB"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="ComboBoxItem"><Setter Property="Padding" Value="10,8"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="option" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="option" Property="Background" Value="#E2EEFF"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="option" Property="Background" Value="#D4E7FF"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <!-- Hover/focus decorations are overlays; they never resize the track or move its child. -->
  <Style TargetType="CheckBox">
   <Setter Property="FontSize" Value="13"/><Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="Margin" Value="0,10"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
    <DockPanel Background="Transparent">
     <Grid x:Name="switchSurface" Width="40" Height="24" Margin="0,0,12,0" VerticalAlignment="Center" ClipToBounds="False">
      <Border x:Name="track" CornerRadius="12" Background="#D0D9E7"/>
      <Border x:Name="switchHover" CornerRadius="12" BorderBrush="#83ABE4" BorderThickness="2" Background="#187BAEFF" Opacity="0" IsHitTestVisible="False"/>
      <Ellipse x:Name="knob" Width="18" Height="18" Fill="White" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="3,0,0,0"><Ellipse.RenderTransform><TranslateTransform X="0"/></Ellipse.RenderTransform></Ellipse>
      <Border x:Name="switchFocus" CornerRadius="12" BorderBrush="#17283E" BorderThickness="2" Opacity="0" IsHitTestVisible="False"/>
     </Grid>
     <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True"/>
    </DockPanel>
    <ControlTemplate.Triggers>
     <Trigger Property="IsChecked" Value="True"><Setter TargetName="track" Property="Background" Value="#3778DF"/><Setter TargetName="knob" Property="RenderTransform"><Setter.Value><TranslateTransform X="16"/></Setter.Value></Setter></Trigger>
     <MultiTrigger><MultiTrigger.Conditions><Condition Property="IsChecked" Value="True"/><Condition Property="local:MotionSettings.Enabled" Value="True"/></MultiTrigger.Conditions><MultiTrigger.EnterActions><BeginStoryboard x:Name="SwitchOn"><Storyboard><DoubleAnimation Storyboard.TargetName="knob" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" From="0" To="16" Duration="0:0:0.15" FillBehavior="Stop"/></Storyboard></BeginStoryboard></MultiTrigger.EnterActions><MultiTrigger.ExitActions><RemoveStoryboard BeginStoryboardName="SwitchOn"/></MultiTrigger.ExitActions></MultiTrigger>
     <MultiTrigger><MultiTrigger.Conditions><Condition Property="IsChecked" Value="False"/><Condition Property="local:MotionSettings.Enabled" Value="True"/></MultiTrigger.Conditions><MultiTrigger.EnterActions><BeginStoryboard x:Name="SwitchOff"><Storyboard><DoubleAnimation Storyboard.TargetName="knob" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" From="16" To="0" Duration="0:0:0.15" FillBehavior="Stop"/></Storyboard></BeginStoryboard></MultiTrigger.EnterActions><MultiTrigger.ExitActions><RemoveStoryboard BeginStoryboardName="SwitchOff"/></MultiTrigger.ExitActions></MultiTrigger>
     <MultiTrigger><MultiTrigger.Conditions><Condition Property="IsMouseOver" Value="True"/><Condition Property="IsEnabled" Value="True"/><Condition Property="local:MotionSettings.Enabled" Value="True"/></MultiTrigger.Conditions><MultiTrigger.EnterActions><RemoveStoryboard BeginStoryboardName="SwitchHoverExit"/><BeginStoryboard x:Name="SwitchHoverEnter"><Storyboard><DoubleAnimation Storyboard.TargetName="switchHover" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.14"/></Storyboard></BeginStoryboard></MultiTrigger.EnterActions><MultiTrigger.ExitActions><RemoveStoryboard BeginStoryboardName="SwitchHoverEnter"/><BeginStoryboard x:Name="SwitchHoverExit"><Storyboard><DoubleAnimation Storyboard.TargetName="switchHover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.14" FillBehavior="Stop"/></Storyboard></BeginStoryboard></MultiTrigger.ExitActions></MultiTrigger>
     <MultiTrigger><MultiTrigger.Conditions><Condition Property="IsMouseOver" Value="True"/><Condition Property="IsEnabled" Value="True"/><Condition Property="local:MotionSettings.Enabled" Value="False"/></MultiTrigger.Conditions><Setter TargetName="switchHover" Property="Opacity" Value="1"/></MultiTrigger>
     <Trigger Property="local:MotionSettings.Enabled" Value="False"><Trigger.EnterActions><RemoveStoryboard BeginStoryboardName="SwitchOn"/><RemoveStoryboard BeginStoryboardName="SwitchOff"/><RemoveStoryboard BeginStoryboardName="SwitchHoverEnter"/><RemoveStoryboard BeginStoryboardName="SwitchHoverExit"/></Trigger.EnterActions></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="switchFocus" Property="Opacity" Value="1"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/><Setter Property="Cursor" Value="Arrow"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
 </Application.Resources>
</Application>


